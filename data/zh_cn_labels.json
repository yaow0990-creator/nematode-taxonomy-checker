  "1": {"cn": "极机会型", "desc": "世代极短、繁殖率极高、富营养条件下快速增长；贫营养时形成休眠幼虫；以细菌食为主"},
  "2": {"cn": "机会型", "desc": "世代短、繁殖率高（低于 c-p1）；不形成休眠幼虫；分布广、耐污染与干扰；以细菌食、真菌食为主，少数捕食"},
  "3": {"cn": "中间型", "desc": "世代较 c-p2 长，对干扰更敏感；细菌食、真菌食及部分捕食"},
  "4": {"cn": "敏感型", "desc": "小型矛线类与大型非矛线类，生殖腺占体比例低；世代长、角质层通透性强"},
  "5": {"cn": "持久型", "desc": "大型矛线类，寿命长、繁殖率低、代谢低；对污染物与干扰极敏感；大型杂食者与捕食者"}
